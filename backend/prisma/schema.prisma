
generator client {
  provider = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum IncidentStatus{
  RECEIVED
  IN_PROGRESS
  RESOLVED
  FAILED
}

model Incident {
  id String @id @default(uuid())
  repository String
  branch String
  commitSha String
  exception String
  file String
  line Int 
  environment String
  status IncidentStatus @default(RECEIVED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}