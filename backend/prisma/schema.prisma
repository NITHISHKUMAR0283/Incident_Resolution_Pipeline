
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Incident {
  id String @id @default(uuid())
  repository String
  branch String
  commitSha String
  exception String
  file String
  line Int 
  environment String
  status String @default("RECEIVED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}